# Top-level (curated) dependencies for Finlity.
#
# This file is the source of truth. Regenerate the pinned lockfile with:
#     pip-compile --resolver=backtracking \
#        --output-file requirements.txt requirements.in
#
# Only add top-level deps here. Transitive deps are resolved by pip-compile.
#
# 2026-06-09 dependency audit: removed 21 packages with zero import sites
# across src/, scripts/, and tests/ (verified by full import census plus
# implicit-use checks for FastAPI extras: EmailStr, ORJSONResponse,
# EventSourceResponse, WebSocket, load_dotenv, pydantic_settings):
#   aiohttp, aiosqlite, scikit-learn, bcrypt, PyJWT, Authlib, pillow,
#   pydantic-settings, jsonschema, typer, sse-starlette, websockets,
#   mcp, fastmcp, tenacity, orjson, email-validator, python-dotenv,
#   pypdfium2, gunicorn (Dockerfile + heroku.yml both run
#   `python -m src.main` directly), and PyPDF2 (abandoned upstream;
#   replaced by the maintained fork `pypdf`).
# Restore any of these from git history if a feature starts needing them.

# Core web framework
fastapi>=0.115.0
# Floor bumped 1.0.1 -> 1.3.1; clears PYSEC-2026-248 (Host-header path
# injection via unvalidated request.url) and PYSEC-2026-249 (urlencoded
# form parsing ignores max_fields/max_part_size). FastAPI 0.136 allows
# starlette>=0.46.0, so 1.3.1 is compatible.
starlette>=1.3.1
uvicorn[standard]==0.38.0
uvloop==0.21.0
httptools==0.6.4

# HTTP clients
httpx==0.28.1
# Bumped 2.32.5 -> 2.33.1; clears CVE-2026-25645 (.netrc auth leak)
requests==2.33.1
# Transitive (via requests/httpx/anthropic), pinned directly to clear
# CVE-2026-45409 (idna.encode DoS on very large inputs); fixed in 3.15.
idna>=3.15

# Data processing
# numpy 2.0.0 / pandas 2.2.2 do not ship Python 3.13 wheels and fail to build
# from source under GCC 13. Pin to versions with cp313 wheels on PyPI.
numpy==2.2.4
pandas==2.2.3
scipy==1.15.3
openpyxl==3.1.5

# Market data (pinned to guard against upstream scraping changes).
# Bumped 0.2.50 -> 1.4.1 (2026-06-09): Yahoo endpoint changes broke 0.2.50
# entirely ("Expecting value: line 1 column 1" on every fetch; SWPPX/VFIAX
# reported as delisted). App uses only Ticker().history() + .info, which are
# unchanged in 1.x.
yfinance==1.4.1


# ===========================================
# SECURITY: Files excluded to prevent PII leakage
# ===========================================

# ----- Python -----
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
ENV/
env/
.eggs/
*.egg-info/
dist/
build/

# ----- Node.js -----
node_modules/
.npm/
.eslintcache

# ----- Sensitive Data (contains financial info & PII) -----
# Database files (contain account names, positions, API keys)
# Note: data/demo/demo.db is explicitly tracked for deployments
*.db
!data/demo/demo.db
*.sqlite
*.sqlite3
portfolio.db
data/*
!data/demo/

# Exported data (contain account names with PII)
exports/
output/

# CSV/Excel files (may contain brokerage exports with personal info)
*.csv
*.xlsm
*.xlsx
*.xls

# JSON data files (may contain portfolio data)
# Note: config files are safe to commit
*.json
!package.json
!package-lock.json
!tsconfig.json
!.claude/*.json

# ----- Secrets & API Keys -----
.env
.env.*
!.env.example
*.env
.envrc
credentials*
secrets.*
!src/services/secrets.py
*.pem
*.key
*_key.txt
api_keys.txt

# Backup files (may contain sensitive data)
*.bak
*.backup
*backup*.json
*export*.json

# ----- Claude Code Settings -----
# Track .claude folder for shared development configuration
# (skills, agents, permission settings, etc.)
# Note: Never store API keys or secrets in .claude/

# ----- Log Files (may contain URLs, account activity) -----
*.log
logs/

# ----- IDE & Editor -----
.idea/
.vscode/
*.swp
*.swo
*~
.project
.settings/

# ----- OS -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ----- Cache -----
.cache/
*.cache
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ----- Test/Coverage -----
.coverage
htmlcov/
.tox/
.nox/

# ----- Jupyter Notebooks (may contain output with PII) -----
.ipynb_checkpoints/
*.ipynb

# ----- Screenshots (may contain sensitive data) -----
screenshots/
*.png
*.jpg
*.jpeg
!src/web/assets/*.png
!src/web/assets/*.jpg
!src/web/images/*.png
!src/web/images/*.jpg
!docs/images/*.png
!docs/images/*.jpg

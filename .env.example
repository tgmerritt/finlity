# Investment Portfolio Analyzer - Environment Variables
# Copy this file to .env and fill in your API keys
#
# These keys are used for:
# - Real-time stock/fund prices
# - AI-powered fund analysis and chat
#
# All keys are optional - the app works without them but with limited features

# ============================================================================
# AI Analysis (Claude API)
# ============================================================================
# Used for: Fund analysis, portfolio insights, chat advisor
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Claude model to use (optional - defaults to claude-sonnet-4-20250514)
# Available models:
#   - opus   (or claude-opus-4-5-20251101)    : Most capable, best for complex analysis
#   - sonnet (or claude-sonnet-4-20250514)    : Balanced performance/cost (default)
#   - haiku  (or claude-3-5-haiku-20241022)   : Fastest, cheapest
# You can use aliases (opus, sonnet, haiku) or full model IDs
ANTHROPIC_MODEL=sonnet

# ============================================================================
# AI Analysis (Gemini API)
# ============================================================================
# Used for: Fund analysis, portfolio insights, chat advisor
# Get your key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ============================================================================
# Market Data Providers (for real-time prices)
# ============================================================================

# Alpha Vantage - Free tier: 25 requests/day
# Get your key at: https://www.alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=

# Finnhub - Free tier: 60 requests/minute
# Get your key at: https://finnhub.io/register
FINNHUB_API_KEY=

# ============================================================================
# Notes
# ============================================================================
# - yfinance is used as the primary price source (no API key needed)
# - Alpha Vantage and Finnhub are fallbacks for better reliability
# - Without ANTHROPIC_API_KEY, AI features show "API key not configured"
